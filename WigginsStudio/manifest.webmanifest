{
  "name": "Wiggins Report Studio",
  "short_name": "Report Studio",
  "description": "Inspection reports for Wiggins & Associates Architects, finished as PDF and Word.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1A1C20",
  "theme_color": "#1E2024",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".wiggins"] } }
  ]
}
